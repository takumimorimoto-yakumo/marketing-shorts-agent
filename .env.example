# ── Content service ───────────────────────────────────────────────────────────
# URL of the content service. Leave empty to use the bundled content-stub.
CONTENT_URL=

# ── Storyboard service ────────────────────────────────────────────────────────
# URL of the storyboard service. Leave empty to use the bundled storyboard-stub.
STORYBOARD_URL=

# ── Renderer ─────────────────────────────────────────────────────────────────
# URL of the renderer service. Leave empty to use the bundled renderer-stub.
RENDERER_URL=

# ── Google Cloud ──────────────────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_REGION=us-central1

# ── Gemini / Vertex AI model IDs ─────────────────────────────────────────────
# Script generation model
GEMINI_SCRIPT_MODEL=gemini-2.5-flash
# Storyboard generation model
GEMINI_STORYBOARD_MODEL=gemini-2.5-flash
# YMYL evaluation model
GEMINI_EVAL_MODEL=gemini-2.5-flash

# ── Veo / Imagen / Chirp / Lyria ─────────────────────────────────────────────
VEO_MODEL=veo-3.0-generate-preview
IMAGEN_MODEL=imagen-3.0-generate-001
CHIRP_VOICE=ja-JP-Standard-D
LYRIA_MODEL=lyria-2

# ── YouTube ───────────────────────────────────────────────────────────────────
# OAuth credentials for YouTube Data API v3
YOUTUBE_CLIENT_SECRETS_FILE=
# Channel id to publish to
YOUTUBE_CHANNEL_ID=

# ── agentops-platform integration ─────────────────────────────────────────────
AGENTOPS_BASE_URL=https://agentops-platform.run.app
AGENTOPS_AGENT_ID=marketing-shorts-agent
AGENTOPS_API_KEY=

# ── Video QA ──────────────────────────────────────────────────────────────────
# VIDEO_QA_USE_GEMINI=false → stub (always passes, no external deps)
# VIDEO_QA_USE_GEMINI=true  → real checks: ffprobe + Gemini multimodal visual judgment
#   Requires ffprobe on PATH and ADC credentials (gcloud auth application-default login).
VIDEO_QA_USE_GEMINI=false
# Backend for Gemini visual check: 'genai' (google-generativeai) or 'vertex'
VIDEO_QA_GEMINI_BACKEND=genai

# ── Runtime ───────────────────────────────────────────────────────────────────
# dry_run=true → publisher does not actually upload; prints what it would do.
DRY_RUN=true
LOG_LEVEL=INFO

# ── Renderer-stub (only needed when running the bundled stub) ─────────────────
RENDERER_STUB_PORT=8080
